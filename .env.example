# =====================================================================
# ENVIRONMENT TEMPLATE — copy to `.env` and fill in real values.
# `.env` is gitignored; set the same keys in your host (Vercel/Netlify).
# =====================================================================

# Canonical base URL — drives canonical/og:url, sitemap, hreflang.
NUXT_PUBLIC_SITE_URL=https://xperience-hotels.com

# --- Storyblok: Content Delivery (read content into the app) ----------
# Public/Preview access token from Storyblok > Settings > Access Tokens.
# Read by @storyblok/nuxt (module accessToken) AND runtimeConfig.storyblokToken.
# Public token = published content only; Preview token = draft (Visual Editor).
NUXT_STORYBLOK_TOKEN=

# --- Storyblok: Management API (push/migrate content — scripts only) ---
# Personal Access Token from Storyblok > My Account > Personal access tokens.
# SECRET. Used by tooling only, never exposed to the running app.
STORYBLOK_PERSONAL_ACCESS_TOKEN=
STORYBLOK_SPACE_ID=
STORYBLOK_REGION=eu
