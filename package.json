  },
  "dependencies": {
    "@blossom-carousel/vue": "^1.1.1",
    "@lucide/vue": "^1.17.0",
    "@nuxt/image": "^2.0.0",
    "@storyblok/nuxt": "^10.1.10",
    "leaflet": "^1.9.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/robots": "^6.1.1",
    "@nuxtjs/sitemap": "^8.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.2",
    "nuxt": "^4.4.8",
    "sass": "^1.100.0",
    "typescript": "~6.0.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
