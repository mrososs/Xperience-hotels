  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:https": "nuxt dev --https --https.cert certs/localhost.pem --https.key certs/localhost-key.pem --port 3001",
    "build": "nuxt build",
    "preview": "nuxt preview",
